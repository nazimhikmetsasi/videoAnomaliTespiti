# Ornek ortam dosyasi. Kopyala: cp .env.example .env
# Burada SADECE sirlar ve baglanti bilgileri bulunur.
# Tespit esikleri veritabaninda (detection_settings) yasar, burada degil.

# --- PostgreSQL ---
POSTGRES_USER=anomaly
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=anomaly
# v1 projesi (VideoAnomalySystem) 5432 ve 27017yi kullaniyor; cakismasin diye kaydirildi
POSTGRES_PORT=5433

# Admin kullanicisinin ilk sifresi. init.sql bunu pgcrypto ile bcrypt'ler.
# Ilk giristen sonra panelden degistirilmelidir.
ADMIN_PASSWORD=change_me_admin

# --- MongoDB ---
MONGO_USER=anomaly
MONGO_PASSWORD=change_me_mongo
MONGO_DB=anomaly
MONGO_PORT=27018

# --- Kafka ---
# Host'ta calisan vision/ servisi bu adresi kullanir.
KAFKA_BOOTSTRAP_HOST=localhost:9092
# Docker ici servisler (spark, api) bu adresi kullanir.
KAFKA_BOOTSTRAP_INTERNAL=kafka:29092

# --- API (Asama 5) ---
API_PORT=8000
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRE_MINUTES=720

# --- Spark esik cekme (Asama 6, ASAMA6_PLAN.md SS9) ---
# GET /api/settings kimlik ister. Bir admin jetonu alip buraya koyun:
#   POST /api/auth/login -> access_token
# Bos birakilirsa istek 401 alir, spark_job.py tek satir uyari basar ve
# SPARK_* ortam varsayilanlarinda kalir -- akis yine baslar.
SPARK_SETTINGS_TOKEN=
# Bos birakilirsa api/config.py bunlari yukaridaki POSTGRES_*/MONGO_*
# degiskenlerinden host'a gore kurar (venv'den localhost ile calisirken).
# docker-compose api/consumer servisleri bunlari kendi ortaminda container
# adiyla (postgres/mongo) doldurur.
DATABASE_URL=
MONGO_URL=

# --- LLM (Asama 7) ---
GEMINI_API_KEY=

# --- Telegram (Asama 7) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
